# Empower Backend Environment Configuration

# Security
EMPOWER_SECRET_KEY=development-only-change-me-32-bytes-minimum


# Database
DATABASE_URL=sqlite:///./empower.db


# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password
# Set to true to send welcome emails after signup.
EMAIL_ENABLED=false


# Debug Mode
DEBUG=False

# Empower Backend Environment Configuration
# Copy to .env (backend/.env) for local dev. NEVER commit .env.

# --- Core (consumed by app/core/config.py) ---
# SQLite default for local dev; Postgres for staging/prod:
#   DATABASE_URL=postgresql+psycopg://empower:change-me@localhost:5432/empower
DATABASE_URL=sqlite:///./empower.db

# Legacy alias also read by automation + compose; keep in sync with SECRET_KEY.
EMPOWER_SECRET_KEY=development-only-change-me

# --- Automation / compose / deploy (consumed by automation + docker-compose) ---
ENVIRONMENT=development
SECRET_KEY=development-only-change-me
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_NAME=Empower API
APP_VERSION=1.0.0

# Debug Mode
DEBUG=False
